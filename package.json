{
  "name": "ymi-story-json-creator",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone Windows desktop app for story subtitle JSON creation.",
  "author": "YMI",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --configLoader native\" \"wait-on tcp:5173 && electron .\"",
    "build:web": "vite build --configLoader native",
    "build": "npm run build:web",
    "dist": "npm run build:web && electron-builder --win nsis",
    "dist:dir": "npm run build:web && electron-builder --win dir",
    "build:gh-pages": "vite build --config vite.config.web.mjs --configLoader native",
    "deploy": "npm run build:gh-pages && gh-pages -d dist-web -m \"Deploy web app\""
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "electron": "^38.3.0",
    "electron-builder": "^26.0.12",
    "gh-pages": "^6.3.0",
    "vite": "^7.1.12",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.ymi.story-json-creator",
    "productName": "YMI Story JSON Creator",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
